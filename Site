<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Empire State Family Child Care Collaborative</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --sky: #3BBDE4;
      --coral: #F26C4F;
      --sun: #F9C547;
      --mint: #5DC89A;
      --lavender: #9B7FD4;
      --cream: #FDF6EC;
      --dark: #2C3E50;
      --white: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Nunito', sans-serif;
      background: var(--cream);
      color: var(--dark);
      overflow-x: hidden;
    }

    /* ── HERO ── */
    header {
      background: linear-gradient(135deg, var(--sky) 0%, #1a91c4 100%);
      position: relative;
      overflow: hidden;
      padding: 60px 40px 80px;
      text-align: center;
    }

    header::before {
      content: '';
      position: absolute;
      bottom: -40px; left: 0; right: 0;
      height: 80px;
      background: var(--cream);
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }

    /* floating bubbles */
    .bubble {
      position: absolute;
      border-radius: 50%;
      opacity: 0.18;
      animation: float 6s ease-in-out infinite;
    }
    .bubble:nth-child(1){ width:120px;height:120px;background:var(--sun);  top:10%; left:5%;  animation-delay:0s;}
    .bubble:nth-child(2){ width:80px; height:80px; background:var(--coral);top:60%; left:2%;  animation-delay:1s;}
    .bubble:nth-child(3){ width:160px;height:160px;background:var(--mint); top:5%;  right:4%; animation-delay:2s;}
    .bubble:nth-child(4){ width:60px; height:60px; background:var(--white);top:70%; right:8%; animation-delay:0.5s;}
    .bubble:nth-child(5){ width:100px;height:100px;background:var(--lavender);top:40%;right:2%;animation-delay:1.5s;}

    @keyframes float {
      0%,100%{ transform:translateY(0);}
      50%{ transform:translateY(-18px);}
    }

    .logos-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-bottom: 30px;
      flex-wrap: wrap;
    }

    .header-logo {
      width: 100px;
      height: 100px;
      object-fit: contain;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      padding: 6px;
      backdrop-filter: blur(8px);
      border: 2px solid rgba(255,255,255,0.4);
    }

    .logo-badge {
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(8px);
      border: 2px solid rgba(255,255,255,0.4);
      border-radius: 16px;
      padding: 10px 20px;
      color: white;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    .rocket-icon {
      font-size: 3.5rem;
      display: block;
      margin: 0 auto 16px;
      animation: launch 3s ease-in-out infinite;
    }
    @keyframes launch {
      0%,100%{ transform:translateY(0) rotate(-5deg);}
      50%{ transform:translateY(-12px) rotate(5deg);}
    }

    header h1 {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(2rem, 5vw, 3.6rem);
      color: var(--white);
      line-height: 1.15;
      text-shadow: 0 3px 12px rgba(0,0,0,0.15);
    }
    header h1 span { color: var(--sun); }

    header p.sub {
      margin-top: 12px;
      font-size: 1.1rem;
      color: rgba(255,255,255,0.9);
      font-weight: 600;
    }

    .free-badge {
      display: inline-block;
      margin-top: 28px;
      background: var(--sun);
      color: var(--dark);
      font-family: 'Fredoka One', cursive;
      font-size: 1.5rem;
      padding: 10px 36px;
      border-radius: 50px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.15);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100%{ transform:scale(1);}
      50%{ transform:scale(1.05);}
    }

    /* ── BENEFITS ── */
    .section { padding: 70px 30px; }

    .section-title {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      text-align: center;
      margin-bottom: 50px;
      position: relative;
    }
    .section-title::after {
      content: '';
      display: block;
      width: 80px;
      height: 5px;
      border-radius: 3px;
      margin: 12px auto 0;
    }
    .section-title.coral { color: var(--coral); }
    .section-title.coral::after { background: var(--coral); }
    .section-title.sky   { color: var(--sky);   }
    .section-title.sky::after   { background: var(--sky);   }
    .section-title.mint  { color: var(--mint);  }
    .section-title.mint::after  { background: var(--mint);  }

    /* headline benefits */
    .headline-benefits {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .hb-card {
      flex: 1 1 260px;
      max-width: 320px;
      border-radius: 24px;
      padding: 36px 28px;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,0.09);
      transition: transform 0.3s, box-shadow 0.3s;
    }
    .hb-card:hover { transform: translateY(-8px); box-shadow: 0 16px 40px rgba(0,0,0,0.14); }

    .hb-card.c1 { background: #FFF0EC; }
    .hb-card.c2 { background: #EDFAF3; }
    .hb-card.c3 { background: #EEF6FF; }

    .hb-icon { font-size: 3rem; margin-bottom: 16px; display: block; }

    .hb-card h3 {
      font-family: 'Fredoka One', cursive;
      font-size: 1.5rem;
      margin-bottom: 10px;
    }
    .hb-card.c1 h3 { color: var(--coral); }
    .hb-card.c2 h3 { color: var(--mint);  }
    .hb-card.c3 h3 { color: var(--sky);   }

    .hb-card p { font-size: 0.98rem; color: #555; line-height: 1.6; }

    /* ── FEATURES ── */
    .features-bg {
      background: linear-gradient(160deg, #f0faf6 0%, #e8f6ff 100%);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 24px;
      max-width: 1000px;
      margin: 0 auto;
    }

    .feat-card {
      background: white;
      border-radius: 20px;
      padding: 30px 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.07);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      transition: transform 0.3s;
      border-top: 5px solid transparent;
    }
    .feat-card:hover { transform: translateY(-6px); }
    .feat-card:nth-child(1){ border-color: var(--coral); }
    .feat-card:nth-child(2){ border-color: var(--sky);   }
    .feat-card:nth-child(3){ border-color: var(--sun);   }
    .feat-card:nth-child(4){ border-color: var(--mint);  }

    .feat-icon {
      width: 52px; height: 52px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem;
    }
    .feat-card:nth-child(1) .feat-icon { background: #FFF0EC; }
    .feat-card:nth-child(2) .feat-icon { background: #E5F6FE; }
    .feat-card:nth-child(3) .feat-icon { background: #FEF9E5; }
    .feat-card:nth-child(4) .feat-icon { background: #EDFAF3; }

    .feat-card h4 {
      font-family: 'Fredoka One', cursive;
      font-size: 1.15rem;
      color: var(--dark);
    }
    .feat-card p { font-size: 0.92rem; color: #666; line-height: 1.55; }

    /* ── PARTNERS ── */
    .partners-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      max-width: 700px;
      margin: 0 auto 20px;
    }

    .partner-pill {
      background: white;
      border: 2px solid var(--sky);
      border-radius: 50px;
      padding: 12px 28px;
      font-weight: 800;
      color: var(--sky);
      font-size: 1rem;
      box-shadow: 0 4px 12px rgba(59,189,228,0.15);
    }

    /* ── CTA ── */
    .cta-section {
      background: linear-gradient(135deg, var(--coral) 0%, #e8543a 100%);
      padding: 80px 30px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta-section::before {
      content:'';
      position:absolute;
      top:-60px;left:0;right:0;
      height:80px;
      background:var(--cream);
      border-radius:0 0 50% 50% / 0 0 100% 100%;
    }

    .cta-section h2 {
      font-family: 'Fredoka One', cursive;
      font-size: clamp(2rem, 5vw, 3rem);
      color: white;
      margin-bottom: 16px;
    }
    .cta-section p {
      color: rgba(255,255,255,0.9);
      font-size: 1.1rem;
      margin-bottom: 36px;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }
    .cta-btn {
      display: inline-block;
      background: var(--sun);
      color: var(--dark);
      font-family: 'Fredoka One', cursive;
      font-size: 1.4rem;
      padding: 16px 50px;
      border-radius: 50px;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(0,0,0,0.2);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .cta-btn:hover { transform: scale(1.06); box-shadow: 0 12px 32px rgba(0,0,0,0.28); }

    /* ── CONTACT ── */
    .contact-section {
      padding: 70px 30px;
      background: white;
    }
    .contact-card {
      max-width: 560px;
      margin: 0 auto;
      background: var(--cream);
      border-radius: 28px;
      padding: 48px 40px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0,0,0,0.07);
    }
    .contact-card h3 {
      font-family: 'Fredoka One', cursive;
      font-size: 1.9rem;
      color: var(--sky);
      margin-bottom: 28px;
    }
    .contact-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 16px;
    }
    .contact-icon {
      width: 42px; height: 42px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
    }
    .contact-icon.phone { background: #EEF6FF; }
    .contact-icon.loc   { background: #EDFAF3; }

    /* ── FOOTER ── */
    footer {
      background: var(--dark);
      color: rgba(255,255,255,0.7);
      text-align: center;
      padding: 30px 20px;
      font-size: 0.9rem;
    }
    footer strong { color: white; }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
      header { padding: 50px 20px 70px; }
      .section { padding: 50px 20px; }
      .contact-card { padding: 36px 24px; }
    }
  </style>
</head>
<body>

